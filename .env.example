# Versiones de imágenes
KAFKA_VERSION=4.0.0
MONGO_VERSION=8.0
KAFKA_UI_VERSION=v1.2.0

# Puertos expuestos en tu máquina (cámbialos si ya están ocupados)
KAFKA_HOST_PORT=9092
MONGO_HOST_PORT=27017
KAFKA_UI_PORT=8080
PRODUCTS_API_PORT=8081
CLIENTS_API_PORT=8082
ORDER_PROCESSOR_PORT=8083

# Base de datos de order-processor
MONGO_DB=orders

# Particiones de los tópicos (= concurrencia máxima del listener, ADR-001)
TOPIC_PARTITIONS=3

# Servicios de aplicación
FAULT_INJECTION_ENABLED=true
LOG_LEVEL=info

# Formato JSON de los logs de order-processor: logstash, ecs o gelf
ORDER_PROCESSOR_LOG_FORMAT=logstash
