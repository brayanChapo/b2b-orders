# Los scripts se ejecutan dentro de contenedores Linux: siempre con fin de línea LF,
# aunque el repositorio se clone en Windows. Con CRLF fallan con errores confusos.
*.sh    text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf

# Maven Wrapper: el script Unix con LF y el de Windows con CRLF (requerido por cmd.exe).
mvnw    text eol=lf
*.cmd   text eol=crlf
